# Ignore everything by default
*

# Allow the directory config/ and everything inside it
!config/
!config/**
!THIRD_PARTY_NOTICES.md

# Allow audit and documentation directories
!licenses/
!licenses/**
!tools/
!tools/**
!docs/
!docs/**
!servers.dat

# Allow README.md
!README.md

# Allow .gitignore itself
!.gitignore
config/bigbangessentials/*
config/bigbangregions/*
config/bigbang_tournaments/*
config/bigbang-minigames/*
config/cobbleverse-utilities/*
config/cobbleverse-pvp/*
config/easyvip/*
config/worldedit/*
config/luckperms/*
config/cobbleverse-back.json
config/cobbleverse-cooldowns.json
config/cobbleverse-utilities.json
config/bigbangworld/*
config/chunky/*
config/easylogin/*
config/fabric/*
config/Icl/*
config/jade/*
config/jei/*
config/spark/*
config/jade/usernamecache.json
